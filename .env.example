# ==============================================================================
# Open Food MLOps Configuration
# Copy this file to `.env` and fill in values for your environment.
# ==============================================================================

# Core Application Settings
APP_ENV=development
BASE_DIR=.
LOG_CONFIG_PATH=config/logging.yaml

# MLflow Tracking & Experiment Management
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=open-food-mlops-v2

# REST API Serving Layer Configuration
SERVING_HOST=0.0.0.0
SERVING_PORT=8000

# Prometheus Monitoring & Pushgateway Settings
PUSHGATEWAY_URL=http://pushgateway:9091

# Data Ingestion Settings
DATA_DOWNLOAD_URL=https://static.openfoodfacts.org/data/en.openfoodfacts.org.products.csv.gz
USER_AGENT=OpenFoodMLOps/1.0 (contact@example.com)

# Persistent Data Storage Paths
PREDICTIONS_PATH=data/production/predictions.parquet
GROUND_TRUTH_PATH=data/processed/processed_data.parquet
REFERENCE_DATA_PATH=data/monitoring/reference.parquet
REFERENCE_PREDICTIONS_PATH=data/monitoring/reference_predictions.parquet
REPORTS_DIR=data/monitoring/reports