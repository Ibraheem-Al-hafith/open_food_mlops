{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "🚨 Model Degradation Ratio",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "model_degradation_ratio", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 1.2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "red", "value": 0.85 },
              { "color": "green", "value": 0.85 }
            ]
          },
          "unit": "percentunit"
        }
      }
    },
    {
      "title": "🎯 Production Macro-F1",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "model_production_macro_f1", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 3 } }
    },
    {
      "title": "📊 Feature Drift Share",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "evidently_share_of_drifted_columns", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.3 },
              { "color": "red", "value": 0.5 }
            ]
          },
          "unit": "percentunit"
        }
      }
    },
    {
      "title": "⚠️ Dataset Drift Flag",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "evidently_dataset_drift", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "STABLE" } }, "type": "value" },
            { "options": { "1": { "text": "DRIFT DETECTED" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "title": "📈 API Request Rate (RPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [{ "expr": "sum(rate(http_requests_total[5m]))", "refId": "A", "legendFormat": "Requests/sec" }]
    },
    {
      "title": "⏱️ P95 API Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))", "refId": "A", "legendFormat": "P95 Latency" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "❌ API Error Rate (5xx)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [{ "expr": "100 * sum(rate(http_requests_total{status_code=~\"5..\"}[5m])) / sum(rate(http_requests_total[5m]))", "refId": "A", "legendFormat": "Error %" }],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },
    {
      "title": "📦 Prediction Volume",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [{ "expr": "sum(rate(model_predictions_total[5m]))", "refId": "A", "legendFormat": "Predictions/sec" }]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["mlops", "openfood", "evidently"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
