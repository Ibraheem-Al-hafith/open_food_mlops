FROM python:3.12-slim

# Install uv from the official Astral image
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Install MLflow using uv with caching enabled for offline/limited network resilience
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system --no-cache mlflow==3.15.2 "anyio<4"

WORKDIR /mlflow

EXPOSE 5000

CMD ["mlflow", "server", \
     "--host", "0.0.0.0", \
     "--port", "5000", \
     "--backend-store-uri", "sqlite:////mlflow/mlflow.db", \
     "--artifacts-destination", "/mlflow/mlruns", \
     "--serve-artifacts", \
     "--allowed-hosts", "*"]